Allow overriding host WebSocket port via SENDSPIN_WS_PORT env

Upstream sendspin-cpp v0.5.0 hardcodes the host build's WebSocket
listener port to 8928 (src/host/ws_server.cpp). This prevents running
multiple sendspin_player instances on one device — every binary tries
to bind 8928 and the second one fails.

universal_proxy spawns one sendspin_player per ALSA output, so we need
distinct ports per instance. This patch reads SENDSPIN_WS_PORT from
the environment with a fallback to the upstream default. No upstream
API change. Re-validate on every sendspin-cpp pin bump (see
c_src/sendspin_player/README.md).

--- a/src/host/ws_server.cpp
+++ b/src/host/ws_server.cpp
@@ -19,6 +19,8 @@
 #include "platform/time.h"
 #include "server_connection.h"

+#include <cstdlib>
+#include <cstring>
 #include <limits>

 namespace sendspin {
@@ -41,8 +43,18 @@

     this->client_ = client;

+    // universal_proxy patch: honour SENDSPIN_WS_PORT env so multiple
+    // sendspin_player binaries can coexist on one host. Fallback: 8928.
+    uint16_t port = DEFAULT_SERVER_PORT;
+    if (const char* env = std::getenv("SENDSPIN_WS_PORT")) {
+        int p = std::atoi(env);
+        if (p > 0 && p <= 65535) {
+            port = static_cast<uint16_t>(p);
+        }
+    }
+
     // Create IXWebSocket server on the configured port
-    this->server_ = std::make_unique<ix::WebSocketServer>(DEFAULT_SERVER_PORT, "0.0.0.0");
+    this->server_ = std::make_unique<ix::WebSocketServer>(port, "0.0.0.0");

     this->server_->setOnConnectionCallback(
         [this](const std::weak_ptr<ix::WebSocket>& weak_ws,
@@ -106,7 +118,7 @@
             }
         });

-    SS_LOGI(TAG, "Starting server on port: %d (max connections: %d)", DEFAULT_SERVER_PORT,
+    SS_LOGI(TAG, "Starting server on port: %d (max connections: %d)", port,
             this->max_connections_);

     auto result = this->server_->listen();
