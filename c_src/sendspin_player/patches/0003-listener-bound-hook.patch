--- a/src/host/ws_server.cpp
+++ b/src/host/ws_server.cpp
@@ -26,8 +26,18 @@
 
 #include <atomic>
 #include <cstddef>
+#include <cstdint>
 #include <utility>
 
+// universal_proxy patch: listener-bound hook. The embedding binary may
+// define this symbol to learn exactly when the WebSocket listener has
+// successfully bound and started accepting connections. Declared weak so
+// the library (and upstream examples) still link when no definition is
+// provided. This is authoritative where an external port probe is not:
+// it fires only for THIS process's listener, never for a foreign or
+// dying-predecessor socket holding the port.
+extern "C" void sendspin_host_listener_bound(uint16_t port) __attribute__((weak));
+
 namespace sendspin {
 
 static const char* const TAG = "sendspin.ws_server";
@@ -164,6 +174,13 @@ bool SendspinWsServer::start(SendspinClient* client, bool /*task_stack_in_psram*
     }
 
     this->server_->start();
+
+    // universal_proxy patch: notify the embedder that the listener is up.
+    if (&sendspin_host_listener_bound != nullptr) {
+        const uint16_t port = this->server_port_;
+        sendspin_host_listener_bound(port);
+    }
+
     return true;
 }
 
