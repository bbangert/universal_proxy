<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title><%= assigns[:page_title] || "Universal Proxy" %></title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script>
      // Apply persisted/preferred theme before paint to avoid a flash.
      (function () {
        try {
          var stored = localStorage.getItem("up-theme");
          var theme = stored || "auto";
          var effective = theme;
          if (theme === "auto") {
            effective = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", effective);
        } catch (e) {}
      })();
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
  </head>
  <body class="bg-canvas text-fg-1 font-sans antialiased min-h-screen">
    <%= @inner_content %>
  </body>
</html>
